# ─── Environment variables for C23 — Real OAuth with Auth.js ─────────────────
#
# Copy the variables below into your ROOT .env.local file.
# NEVER commit .env.local — it is listed in .gitignore.
#
# ─── Required ─────────────────────────────────────────────────────────────────

# Auth.js signing/encryption secret.
# Used to sign CSRF tokens and encrypt session JWTs (JWE).
# Must be at least 32 bytes of random entropy.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this, a hardcoded dev fallback is used (localhost only — NOT for production).
AUTH_SECRET=

# ─── Optional: GitHub OAuth provider ──────────────────────────────────────────
#
# 1. Create a GitHub OAuth App: https://github.com/settings/applications/new
#    - Homepage URL: http://localhost:3000
#    - Authorization callback URL:
#      http://localhost:3000/c23-oauth-authjs/api/auth/callback/github
#
# 2. Paste the Client ID and Client Secret below.
#
# 3. In app/(challenges)/c23-oauth-authjs/_lib/auth-config.ts:
#    - Uncomment `import GitHub from "next-auth/providers/github"`
#    - Uncomment the `GitHub({})` entry in the providers array
#
# 4. Restart the dev server.
#
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
