# ─── Environment variables for Nextmart ──────────────────────────────────────
#
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it is listed in .gitignore.
#
# Generate SESSION_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# A minimum of 32 bytes of entropy is required for HS256.

# Session signing secret — used by lib/auth/session.ts to sign and verify
# session JWTs.  If unset, a hardcoded dev fallback is used (localhost only).
# MUST be set to a random value in production or any internet-facing deployment.
SESSION_SECRET=
