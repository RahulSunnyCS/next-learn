# ─── Environment variables for Nextmart ──────────────────────────────────────
#
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it is listed in .gitignore.
#
# Generate SESSION_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# A minimum of 32 bytes of entropy is required for HS256.

# Session signing secret — used by lib/auth/session.ts to sign and verify
# session JWTs.  If unset, a hardcoded dev fallback is used (localhost only).
# MUST be set to a random value in production or any internet-facing deployment.
SESSION_SECRET=

# ─── C23: Real OAuth with Auth.js ─────────────────────────────────────────────

# Auth.js signing/encryption secret — used by Challenge C23 to sign CSRF tokens
# and encrypt session JWTs (JWE).  Must be at least 32 bytes of random entropy.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this, a hardcoded dev fallback is used (localhost only — NOT for production).
AUTH_SECRET=

# GitHub OAuth provider credentials — required to use the GitHub sign-in button
# in Challenge C23.  See solutions/c23-oauth-authjs/NOTES.md for setup steps.
# Callback URL: http://localhost:3000/c23-oauth-authjs/api/auth/callback/github
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
