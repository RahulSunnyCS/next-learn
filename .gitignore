.env
.env.*
!.env.example

# ─── Test coverage ───────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Editor / OS artifacts ───────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ─── TypeScript incremental cache ────────────────────────────────────────
tsconfig.tsbuildinfo
*.tsbuildinfo

# ─── Playwright ──────────────────────────────────────────────────────────
playwright-report/
test-results/

# ─── Misc ────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
